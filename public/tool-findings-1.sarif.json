{
  "version": "2.1.0",
  "$schema": "http://json.schemastore.org/sarif-2.1.0-rtm.4",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ExampleTool",
          "informationUri": "https://example.com/tool",
          "rules": []
        }
      },
      "results": [
        {
          "ruleId": "EXMPL001",
          "level": "warning",
          "message": {
            "text": "This is an example warning message."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/example/file1.js"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 5
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
